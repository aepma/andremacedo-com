<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>Label</key>
	<string>telos.andremacedo.refresh</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-l</string>
		<string>-c</string>
		<string>/Users/andrepiresmacedo/andremacedo.com/scripts/refresh.sh</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/andrepiresmacedo/.telos/logs/andremacedo-refresh.stderr.log</string>
	<key>StandardOutPath</key>
	<string>/Users/andrepiresmacedo/.telos/logs/andremacedo-refresh.stdout.log</string>
	<key>StartInterval</key>
	<integer>21600</integer>
	<key>UserName</key>
	<string>andrepiresmacedo</string>
</dict>
</plist>
